DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deribit
REDIS_URL=redis://localhost:6379/0
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
COLLECTION_INTERVAL=60
LOG_LEVEL=INFO

